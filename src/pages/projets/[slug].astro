---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import Icon from '../../components/Icon.astro';
import Topo from '../../components/Topo.astro';
import { ui } from '../../i18n/fr';

export async function getStaticPaths() {
  const projects = (
    await getCollection('projects', (p) => p.id.startsWith('fr/') && !p.data.draft)
  ).sort((a, b) => a.data.order - b.data.order);
  const slugOf = (p: CollectionEntry<'projects'>) => p.id.split('/').at(-1)!;
  return projects.map((project, i) => ({
    params: { slug: slugOf(project) },
    props: {
      project,
      prev: i > 0 ? { slug: slugOf(projects[i - 1]!), title: projects[i - 1]!.data.title } : null,
      next:
        i < projects.length - 1
          ? { slug: slugOf(projects[i + 1]!), title: projects[i + 1]!.data.title }
          : null,
    },
  }));
}

type Nav = { slug: string; title: string } | null;
interface Props {
  project: CollectionEntry<'projects'>;
  prev: Nav;
  next: Nav;
}
const { project, prev, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const hasCode = Boolean(data.links.github);
---

<BaseLayout title={data.title} description={data.tagline}>
  <article>
    <header class="head">
      <Topo class="head__topo" seed={data.order} />
      <div class="container">
        <a class="back" href="/#projets"><Icon name="back" size={16} /> {ui.project.back}</a>
        <div class="badges"><StatusBadge status={data.status} /></div>
        <h1>{data.title}</h1>
        <p class="tagline">{data.tagline}</p>

        <dl class="facts">
          <div><dt>{ui.project.role}</dt><dd>{data.role}</dd></div>
          <div><dt>{ui.project.context}</dt><dd>{data.context}</dd></div>
          {data.period && <div><dt>{ui.project.period}</dt><dd>{data.period}</dd></div>}
          {
            data.metric && (
              <div>
                <dt>Résultat</dt>
                <dd>
                  <strong>{data.metric.value}</strong> {data.metric.label}
                </dd>
              </div>
            )
          }
        </dl>

        <div class="links">
          {
            data.links.site && (
              <a class="btn btn--primary" href={data.links.site}>
                {ui.project.site} <Icon name="external" size={16} />
              </a>
            )
          }
          {
            data.links.demo && (
              <a class="btn" href={data.links.demo}>
                {ui.project.demo} <Icon name="external" size={16} />
              </a>
            )
          }
          {
            hasCode ? (
              <a class="btn" href={data.links.github}>
                {ui.project.code} <Icon name="external" size={16} />
              </a>
            ) : (
              <span class="private">
                <Icon name="lock" size={16} /> {ui.project.privateCode}
              </span>
            )
          }
        </div>
      </div>
    </header>

    {
      data.cover && (
        <div class="container cover">
          <Picture
            src={data.cover}
            formats={['avif', 'webp']}
            widths={[800, 1400, 2200]}
            sizes="(max-width: 1160px) 100vw, 1120px"
            alt={data.coverAlt ?? ''}
            loading="eager"
          />
        </div>
      )
    }

    <div class="container body">
      <div class="prose">
        <Content />
      </div>
      <aside class="stack">
        <h2>{ui.project.stack}</h2>
        <ul>{data.stack.map((s) => <li class="tag">{s}</li>)}</ul>
      </aside>
    </div>

    {
      data.gallery.length > 0 && (
        <section class="container gallery" aria-label={ui.project.gallery}>
          <h2>{ui.project.gallery}</h2>
          <div class="gallery__grid">
            {data.gallery.map((g) => (
              <figure>
                <Picture
                  src={g.src}
                  formats={['avif', 'webp']}
                  widths={[600, 1200]}
                  sizes="(max-width: 860px) 100vw, 540px"
                  alt={g.alt}
                />
                <figcaption>{g.alt}</figcaption>
              </figure>
            ))}
          </div>
        </section>
      )
    }

    <nav class="container pager" aria-label="Autres projets">
      {
        prev ? (
          <a href={`/projets/${prev.slug}/`}>
            <span>{ui.project.prev}</span>
            {prev.title}
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a href={`/projets/${next.slug}/`} class="pager__next">
            <span>{ui.project.next}</span>
            {next.title}
          </a>
        )
      }
    </nav>
  </article>
</BaseLayout>

<style>
  .head {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: var(--space-5) var(--space-4);
  }
  .head :global(.head__topo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    color: var(--accent);
    opacity: 0.07;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--muted);
    text-decoration: none;
  }
  .back:hover {
    color: var(--accent);
  }
  .badges {
    margin-top: var(--space-4);
  }
  h1 {
    font-size: var(--step-3);
    margin-top: var(--space-2);
  }
  .tagline {
    font-size: var(--step-1);
    color: var(--muted);
    max-width: 60ch;
    margin-top: var(--space-2);
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
    padding: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  dt {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  dd {
    margin: 0.25rem 0 0;
    font-size: 0.9375rem;
  }
  dd strong {
    font-family: var(--font-mono);
    color: var(--accent);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
    align-items: center;
  }
  .private {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--muted);
  }
  .cover :global(img) {
    width: 100%;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }
  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: var(--space-5);
    padding-block: var(--space-5);
  }
  .prose {
    max-width: 68ch;
  }
  .prose :global(h2) {
    font-size: var(--step-1);
    margin: var(--space-4) 0 var(--space-2);
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(p),
  .prose :global(ul) {
    margin: 0 0 var(--space-2);
    color: #c9d1d9;
  }
  .prose :global(em) {
    color: var(--muted);
  }
  .stack h2,
  .gallery h2 {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: var(--space-2);
  }
  .stack ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .stack .tag {
    color: var(--text);
  }
  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr));
    gap: var(--space-3);
  }
  figure {
    margin: 0;
  }
  figure :global(img) {
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }
  figcaption {
    font-size: var(--step--1);
    color: var(--muted);
    margin-top: 0.5rem;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    padding-block: var(--space-5);
  }
  .pager a {
    display: grid;
    gap: 0.25rem;
    text-decoration: none;
    color: var(--text);
    font-weight: 600;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-2) var(--space-3);
  }
  .pager a:hover {
    border-color: var(--accent);
  }
  .pager span {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    font-weight: 400;
  }
  .pager__next {
    text-align: right;
    margin-left: auto;
  }
  @media (max-width: 860px) {
    .body {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
</style>
