---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import FridgeScrollytelling from '../../components/FridgeScrollytelling.astro';
import BarosScrollytelling from '../../components/BarosScrollytelling.astro';

export async function getStaticPaths() {
  const projects = (
    await getCollection('projects', (p) => p.id.startsWith('fr/') && !p.data.draft)
  ).sort((a, b) => a.data.order - b.data.order);
  const slugOf = (p: CollectionEntry<'projects'>) => p.id.split('/').at(-1)!;
  return projects.map((project, i) => ({
    params: { slug: slugOf(project) },
    props: {
      project,
      prev: i > 0 ? { slug: slugOf(projects[i - 1]!), title: projects[i - 1]!.data.title } : null,
      next:
        i < projects.length - 1
          ? { slug: slugOf(projects[i + 1]!), title: projects[i + 1]!.data.title }
          : null,
    },
  }));
}

type Nav = { slug: string; title: string } | null;
interface Props {
  project: CollectionEntry<'projects'>;
  prev: Nav;
  next: Nav;
}
const { project, prev, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);

// Scènes 3D pilotées au scroll : ColocOS (frigo) et BarOS (machine éclatée).
// La couverture reste le repli statique pour reduced-motion / petit écran.
const slug = project.id.split('/').at(-1);
const showFridge = slug === 'colocos' && Boolean(data.cover);
const showBaros = slug === 'baros';
---

<ProjectLayout project={project} prev={prev} next={next}>
  <Content />

  <Fragment slot="showcase">
    {
      showFridge && data.cover && (
        <FridgeScrollytelling cover={data.cover} coverAlt={data.coverAlt ?? data.title} />
      )
    }
    {showBaros && <BarosScrollytelling cover={data.cover} coverAlt={data.coverAlt} />}
  </Fragment>
</ProjectLayout>
