---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import FridgeScrollytelling from '../../components/FridgeScrollytelling.astro';

export async function getStaticPaths() {
  const projects = (
    await getCollection('projects', (p) => p.id.startsWith('fr/') && !p.data.draft)
  ).sort((a, b) => a.data.order - b.data.order);
  const slugOf = (p: CollectionEntry<'projects'>) => p.id.split('/').at(-1)!;
  return projects.map((project, i) => ({
    params: { slug: slugOf(project) },
    props: {
      project,
      prev: i > 0 ? { slug: slugOf(projects[i - 1]!), title: projects[i - 1]!.data.title } : null,
      next:
        i < projects.length - 1
          ? { slug: slugOf(projects[i + 1]!), title: projects[i + 1]!.data.title }
          : null,
    },
  }));
}

type Nav = { slug: string; title: string } | null;
interface Props {
  project: CollectionEntry<'projects'>;
  prev: Nav;
  next: Nav;
}
const { project, prev, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);

// Scène 3D pilotée au scroll : uniquement sur la fiche ColocOS, et seulement si
// une couverture existe (elle sert de repli statique pour reduced-motion / mobile).
const slug = project.id.split('/').at(-1);
const hasShowcase = slug === 'colocos' && Boolean(data.cover);
---

<ProjectLayout project={project} prev={prev} next={next}>
  <Content />

  {
    hasShowcase && data.cover && (
      <Fragment slot="showcase">
        <FridgeScrollytelling cover={data.cover} coverAlt={data.coverAlt ?? data.title} />
      </Fragment>
    )
  }
</ProjectLayout>
