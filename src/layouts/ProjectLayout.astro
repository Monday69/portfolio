---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import StatusBadge from '../components/StatusBadge.astro';
import Icon from '../components/Icon.astro';
import Topo from '../components/Topo.astro';
import GalleryStack from '../components/GalleryStack.astro';
import { ui } from '../i18n/fr';

type Nav = { slug: string; title: string } | null;

interface Props {
  project: CollectionEntry<'projects'>;
  prev: Nav;
  next: Nav;
}

const { project, prev, next } = Astro.props;
const { data } = project;
const hasCode = Boolean(data.links.github);
// `Astro.slots.has('showcase')` renvoie true dès qu'un `<Fragment slot="showcase">`
// conditionnel existe dans la page, même quand il ne rend rien : on teste le HTML.
const showcase = await Astro.slots.render('showcase');
const hasShowcase = showcase.trim().length > 0;
---

<BaseLayout title={data.title} description={data.tagline}>
  <article>
    <header class="head">
      <Topo class="head__topo" seed={data.order} />
      <div class="container">
        <a class="back" href="/#projets"><Icon name="back" size={16} /> {ui.project.back}</a>
        <div class="badges"><StatusBadge status={data.status} /></div>
        <h1>{data.title}</h1>
        <p class="tagline">{data.tagline}</p>

        <dl class="facts">
          <div><dt>{ui.project.role}</dt><dd>{data.role}</dd></div>
          <div><dt>{ui.project.context}</dt><dd>{data.context}</dd></div>
          {
            data.period && (
              <div>
                <>
                  <dt>{ui.project.period}</dt>
                  <dd>{data.period}</dd>
                </>
              </div>
            )
          }
          {
            data.metric && (
              <div>
                <dt>Résultat</dt>
                <dd>
                  <strong>{data.metric.value}</strong> {data.metric.label}
                </dd>
              </div>
            )
          }
        </dl>

        <div class="links">
          {
            data.links.site && (
              <a class="btn btn--primary" href={data.links.site}>
                {ui.project.site} <Icon name="external" size={16} />
              </a>
            )
          }
          {
            data.links.demo && (
              <a class="btn" href={data.links.demo}>
                {ui.project.demo} <Icon name="external" size={16} />
              </a>
            )
          }
          {
            hasCode ? (
              <a class="btn" href={data.links.github}>
                {ui.project.code} <Icon name="external" size={16} />
              </a>
            ) : (
              <span class="private">
                <Icon name="lock" size={16} /> {ui.project.privateCode}
              </span>
            )
          }
        </div>
      </div>
    </header>

    {
      hasShowcase ? (
        <div class="container showcase" set:html={showcase} />
      ) : (
        data.cover && (
          <div class="container cover">
            <Picture
              src={data.cover}
              formats={['avif', 'webp']}
              widths={[800, 1400, 2200]}
              sizes="(max-width: 1160px) 100vw, 1120px"
              alt={data.coverAlt ?? ''}
              loading="eager"
            />
          </div>
        )
      )
    }

    <div class="container body">
      <aside class="stack">
        <h2>{ui.project.stack}</h2>
        <ul>{data.stack.map((s) => <li class="tag">{s}</li>)}</ul>
      </aside>
      <div class="prose">
        <slot />
      </div>
    </div>

    {
      data.gallery.length > 0 && (
        <GalleryStack
          items={data.gallery.map((g) => ({ image: g.src, caption: g.alt, alt: g.alt }))}
        />
      )
    }

    <nav class="container pager" aria-label="Autres projets">
      {
        prev ? (
          <a href={`/projets/${prev.slug}/`}>
            <span>{ui.project.prev}</span>
            {prev.title}
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a href={`/projets/${next.slug}/`} class="pager__next">
            <span>{ui.project.next}</span>
            {next.title}
          </a>
        )
      }
    </nav>
  </article>
</BaseLayout>

<script>
  // Apparition progressive des blocs du corps de fiche. Les classes ne sont
  // posées que si l'animation est autorisée : sans JS ou en reduced-motion,
  // le contenu reste pleinement visible.
  const prose = document.querySelector<HTMLElement>('.prose');
  const motionOk = window.matchMedia('(prefers-reduced-motion: no-preference)');

  if (prose && motionOk.matches) {
    const blocks = Array.from(prose.children).filter(
      (el): el is HTMLElement => el instanceof HTMLElement && !el.matches('script, style'),
    );

    // Les quatre cartes de verrous sont animées individuellement (stagger CSS).
    const targets = blocks.flatMap((block) =>
      block.classList.contains('verrous-grid')
        ? Array.from(block.querySelectorAll<HTMLElement>('.verrou-card'))
        : [block],
    );

    for (const el of targets) el.classList.add('reveal-block');

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.04 },
      );
      for (const el of targets) io.observe(el);

      // Arrivée par ancre : le premier écran doit être lisible immédiatement.
      if (window.location.hash) {
        targets.forEach((el) => el.classList.add('is-in'));
      }
    } else {
      targets.forEach((el) => el.classList.add('is-in'));
    }
  }
</script>

<style>
  .head {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: var(--space-5) var(--space-4);
  }
  .head :global(.head__topo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    color: var(--accent);
    opacity: 0.07;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--muted);
    text-decoration: none;
  }
  .back:hover {
    color: var(--accent);
  }
  .badges {
    margin-top: var(--space-4);
  }
  h1 {
    font-size: var(--step-3);
    margin-top: var(--space-2);
  }
  .tagline {
    font-size: var(--step-1);
    color: var(--muted);
    max-width: 60ch;
    margin-top: var(--space-2);
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
    padding: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  dt {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  dd {
    margin: 0.25rem 0 0;
    font-size: 0.9375rem;
  }
  dd strong {
    font-family: var(--font-mono);
    color: var(--accent);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
    align-items: center;
  }
  .private {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--muted);
  }
  .cover :global(img) {
    width: 100%;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }
  .showcase {
    margin-top: var(--space-2);
  }
  /* Largeur de lecture élargie : la fiche respire sur desktop sans perdre
     la colonne de stack à droite. */
  .cover,
  .body {
    width: min(1240px, 92vw);
    margin-inline: auto;
  }
  /* Le showcase (scrollytelling) sort de la largeur de lecture. */
  .showcase {
    width: min(1480px, 95vw);
    margin-inline: auto;
  }
  .body {
    padding-block: var(--space-5);
  }
  .prose {
    max-width: 100%;
  }
  /* Desktop : la stack flotte en haut à droite, le texte coule à côté.
     À partir du deuxième <h2>, tout repasse en pleine largeur. */
  @media (min-width: 861px) {
    .body {
      display: block;
    }
    .stack {
      float: right;
      width: 260px;
      margin: 0 0 1.75rem 3rem;
      position: static;
    }
    /* display: contents : les enfants de .prose deviennent les enfants de
       .body, donc le float et les clear s'appliquent vraiment. */
    .prose {
      display: contents;
    }
    .prose > :global(h2 ~ h2),
    .prose > :global(h2 ~ h2 ~ *) {
      clear: both;
    }
    .prose > :global(h2 ~ h2 ~ p),
    .prose > :global(h2 ~ h2 ~ ul),
    .prose > :global(h2 ~ h2 ~ ol) {
      max-width: 96ch;
    }
    .prose > :global(h2 ~ h2 ~ table),
    .prose > :global(h2 ~ h2 ~ pre),
    .prose > :global(h2 ~ h2 ~ blockquote),
    .prose > :global(.verrous-grid) {
      width: 100%;
      max-width: 100%;
    }
  }
  /* Le texte courant garde une mesure confortable, les blocs larges prennent
     toute la colonne. */
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    max-width: 82ch;
  }
  .prose :global(table),
  .prose :global(pre),
  .prose :global(blockquote),
  .prose :global(figure) {
    max-width: 100%;
  }
  .prose :global(h2) {
    font-size: var(--step-1);
    margin: var(--space-4) 0 var(--space-2);
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(h3) {
    font-size: var(--step-0);
    font-weight: 600;
    color: var(--text);
    margin: var(--space-3) 0 var(--space-1);
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 var(--space-2);
    color: #c9d1d9;
  }
  .prose :global(em) {
    color: var(--muted);
  }
  .prose :global(strong) {
    color: var(--text);
    font-weight: 600;
  }
  /* Listes ordonnées : marqueurs mono alignés sur l'interligne du texte */
  .prose :global(ol) {
    list-style: none;
    counter-reset: prose-step;
    padding-left: 0;
  }
  .prose :global(ol > li) {
    position: relative;
    counter-increment: prose-step;
    padding-left: 2.25rem;
    margin-bottom: var(--space-1);
  }
  .prose :global(ol > li)::before {
    content: counter(prose-step, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0.15em;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--accent);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0 0.3rem;
    background: var(--surface);
  }
  .prose :global(ul > li) {
    margin-bottom: 0.375rem;
  }
  .prose :global(ul > li)::marker {
    color: var(--muted);
  }
  /* Code inline (et blocs éventuels) */
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--text);
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 0.1em 0.35em;
    overflow-wrap: break-word;
  }
  .prose :global(pre) {
    margin: 0 0 var(--space-2);
    padding: var(--space-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    overflow-x: auto;
  }
  .prose :global(pre code) {
    border: 0;
    padding: 0;
    background: none;
    font-size: 0.8125rem;
    line-height: 1.55;
  }
  .prose :global(blockquote) {
    margin: var(--space-2) 0;
    padding: var(--space-1) 0 var(--space-1) var(--space-3);
    border-left: 2px solid var(--accent);
    background: linear-gradient(90deg, var(--accent-soft), transparent 70%);
    color: var(--muted);
    font-style: italic;
  }
  .prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }
  /* Tableaux Markdown (benchmarks, matrices de décision) */
  .prose :global(table) {
    display: block;
    width: 100%;
    max-width: 100%;
    margin: var(--space-2) 0 var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    border-collapse: separate;
    border-spacing: 0;
    overflow-x: auto;
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }
  .prose :global(thead th) {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    text-align: left;
    white-space: nowrap;
    padding: 0.6rem 0.85rem;
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
  }
  .prose :global(td) {
    padding: 0.6rem 0.85rem;
    border-bottom: 1px solid var(--border);
    color: #c9d1d9;
    vertical-align: top;
  }
  .prose :global(tbody tr:last-child td) {
    border-bottom: 0;
  }
  .prose :global(tbody tr:hover td) {
    background: rgb(255 255 255 / 0.02);
  }
  .prose :global(td strong) {
    font-family: var(--font-mono);
    font-weight: 500;
    color: var(--accent);
  }
  .prose :global(td code) {
    white-space: nowrap;
  }
  .stack h2 {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: var(--space-2);
  }
  .stack ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  /* Grille des quatre verrous (HTML injecté depuis le Markdown) */
  .prose :global(.verrous-grid) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    margin: var(--space-2) 0 var(--space-3);
  }
  .prose :global(.verrou-card) {
    display: grid;
    gap: 0.55rem;
    align-content: start;
    padding: var(--space-2);
    border: 1px solid var(--border);
    border-left: 2px solid rgb(125 211 252 / 0.35);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .prose :global(.verrou-card h3) {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .prose :global(.verrou-card p) {
    margin: 0;
    max-width: none;
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--muted);
  }
  .prose :global(.verrou-card p b) {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    display: block;
    margin-bottom: 0.1rem;
  }
  .prose :global(.verrou-card .verrou-impact) {
    color: var(--text);
  }
  .prose :global(.verrou-card .verrou-impact strong) {
    color: var(--accent);
    font-weight: 600;
  }
  .stack .tag {
    color: var(--text);
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    padding-block: var(--space-5);
  }
  .pager a {
    display: grid;
    gap: 0.25rem;
    text-decoration: none;
    color: var(--text);
    font-weight: 600;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-2) var(--space-3);
  }
  .pager a:hover {
    border-color: var(--accent);
  }
  .pager span {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    font-weight: 400;
  }
  .pager__next {
    text-align: right;
    margin-left: auto;
  }
  /* Apparition progressive des blocs du corps (classes posées par le script) */
  @media (prefers-reduced-motion: no-preference) {
    .prose :global(.reveal-block) {
      opacity: 0;
      transform: translateY(22px);
      transition:
        opacity 0.55s ease,
        transform 0.55s ease;
    }
    .prose :global(.reveal-block.is-in) {
      opacity: 1;
      transform: none;
    }
    .prose :global(.verrou-card.reveal-block:nth-child(2)) {
      transition-delay: 0.08s;
    }
    .prose :global(.verrou-card.reveal-block:nth-child(3)) {
      transition-delay: 0.16s;
    }
    .prose :global(.verrou-card.reveal-block:nth-child(4)) {
      transition-delay: 0.24s;
    }
  }

  @media (max-width: 860px) {
    .prose :global(.verrous-grid) {
      grid-template-columns: minmax(0, 1fr);
    }
    /* La stack est avant le texte dans le DOM (pour le float desktop) :
       on rétablit l'ordre de lecture sur mobile. */
    .body {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }
    .prose {
      order: 1;
      min-width: 0;
    }
    .stack {
      order: 2;
      width: 100%;
      float: none;
      margin: 0;
    }
    /* Tableaux larges : on garde le défilement interne au tableau, mais on
       laisse les cellules revenir à la ligne pour éviter tout débordement. */
    .prose :global(td code),
    .prose :global(th) {
      white-space: normal;
    }
    .prose :global(table) {
      -webkit-overflow-scrolling: touch;
    }
  }
  @media (min-width: 861px) {
    .prose > :global(p) {
      max-width: 100%;
    }
    .prose :global(table) {
      display: table;
      width: 100%;
      overflow: visible;
      table-layout: auto;
    }
    .prose :global(thead th) {
      white-space: nowrap;
    }
    .prose :global(tbody tr:last-child td) {
      border-bottom: 0;
    }
  }
</style>
