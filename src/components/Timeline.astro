---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { timeline } from '../data/site';

interface Props {
  background?: ImageMetadata;
  credit?: string;
}
const { background, credit } = Astro.props;
---

<section id="parcours" class="section parcours">
  {
    background && (
      <Picture
        src={background}
        formats={['avif', 'webp']}
        widths={[960, 1600, 2400]}
        sizes="100vw"
        alt=""
        class="parcours__bg"
      />
    )
  }
  {background && <div class="parcours__veil" aria-hidden="true" />}
  {background && credit && <p class="credit">{credit}</p>}
  <div class:list={['container', { parcours__inner: background }]}>
    <p class="eyebrow">Parcours</p>
    <h2 class="section-title">De l’atelier de l’Alpe d’Huez à l’IA appliquée</h2>
    <ol class="timeline">
      {
        timeline.map((item) => (
          <li class:list={['item', 'reveal', `item--${item.kind}`]}>
            <span class="period">{item.period}</span>
            <div>
              <h3>{item.title}</h3>
              <p class="place">{item.place}</p>
              {'detail' in item && item.detail && <p class="detail">{item.detail}</p>}
            </div>
          </li>
        ))
      }
    </ol>
    <p class="legend">
      <span class="key key--experience"></span> Expérience
      <span class="key key--formation"></span> Formation
    </p>
  </div>
</section>

<style>
  .parcours {
    isolation: isolate;
    overflow: hidden;
  }
  .parcours :global(.parcours__bg) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 75% 100%;
  }
  .parcours__veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse 58% 50% at 30% 40%, rgb(14 17 22 / 0.8) 40%, transparent 100%),
      linear-gradient(90deg, rgb(14 17 22 / 0.6) 0%, rgb(14 17 22 / 0.45) 40%, rgb(14 17 22 / 0.1) 70%, transparent 100%),
      linear-gradient(180deg, var(--bg) 0%, transparent 10%, transparent 90%, var(--bg) 100%);
  }
  .parcours :global(.parcours__bg) {
    filter: saturate(0.9);
  }
  @media (min-width: 1025px) {
    .parcours {
      padding-bottom: 14rem;
    }
  }
  .credit {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 1.25rem;
    text-align: right;
    line-height: 1.4;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: rgb(230 237 243 / 0.75);
    text-shadow: 0 1px 6px rgb(14 17 22 / 0.9);
  }
  .timeline,
  .section-title,
  .legend {
    text-shadow: 0 1px 10px rgb(14 17 22 / 0.8);
  }
  @media (max-width: 1024px) {
    .parcours {
      padding-bottom: 20rem;
    }
    .parcours :global(.parcours__bg) {
      object-position: 35% 100%;
    }
    .parcours__veil {
      background: linear-gradient(180deg, var(--bg) 0%, rgb(14 17 22 / 0.85) 10%, rgb(14 17 22 / 0.85) 70%, rgb(14 17 22 / 0.1) 82%, transparent 100%);
    }
  }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 10.5rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 1px;
    background: var(--border);
  }
  .item {
    position: relative;
    display: grid;
    grid-template-columns: 10.5rem 1fr;
    gap: var(--space-4);
    padding-bottom: var(--space-4);
  }
  .item::before {
    content: '';
    position: absolute;
    left: calc(10.5rem - 5px);
    top: 0.45rem;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
  }
  .item--formation::before {
    border-color: var(--muted);
  }
  .period {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--muted);
    text-align: right;
    padding-right: var(--space-2);
    padding-top: 0.15rem;
  }
  h3 {
    font-size: 1.0625rem;
    font-weight: 600;
  }
  .place {
    color: var(--accent);
    font-size: 0.9375rem;
    margin-top: 0.125rem;
  }
  .detail {
    color: var(--muted);
    font-size: 0.9375rem;
    margin-top: 0.375rem;
    max-width: 60ch;
  }
  .legend {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }
  .key {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 2px solid var(--accent);
    margin-left: 0.75rem;
  }
  .key:first-child {
    margin-left: 0;
  }
  .key--formation {
    border-color: var(--muted);
  }
  @media (max-width: 640px) {
    .timeline::before {
      left: 5px;
    }
    .item {
      grid-template-columns: 1fr;
      gap: 0.25rem;
      padding-left: var(--space-3);
    }
    .item::before {
      left: 0;
    }
    .period {
      text-align: left;
      padding: 0;
    }
  }
</style>
