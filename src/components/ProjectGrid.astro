---
import type { CollectionEntry } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import { ui } from '../i18n/fr';
import { categories } from '../content.config';

interface Props {
  projects: CollectionEntry<'projects'>[];
}
const { projects } = Astro.props;
const slugOf = (p: CollectionEntry<'projects'>) => p.id.split('/').at(-1)!;
const featured = projects.filter((p) => p.data.featured);
const others = projects.filter((p) => !p.data.featured);
---

<section id="projets" class="section">
  <div class="container">
    <p class="eyebrow">Projets</p>
    <h2 class="section-title">Des systèmes complets, de la donnée à la production</h2>

    <div class="filters" role="group" aria-label="Filtrer les projets">
      <button type="button" data-filter="all" aria-pressed="true">{ui.categories.all}</button>
      {
        categories.map((c) => (
          <button type="button" data-filter={c} aria-pressed="false">
            {ui.categories[c]}
          </button>
        ))
      }
    </div>

    <div class="featured">
      {featured.map((p) => <ProjectCard project={p} slug={slugOf(p)} large />)}
    </div>
    <div class="grid">
      {others.map((p) => <ProjectCard project={p} slug={slugOf(p)} />)}
    </div>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-cats]');
  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter ?? 'all';
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      cards.forEach((card) => {
        const cats = card.dataset.cats?.split(' ') ?? [];
        card.hidden = filter !== 'all' && !cats.includes(filter);
      });
    }),
  );
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: var(--space-3);
  }
  .filters button {
    font: inherit;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--muted);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.375rem 0.875rem;
    cursor: pointer;
  }
  .filters button:hover {
    color: var(--text);
  }
  .filters button[aria-pressed='true'] {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .featured {
    display: grid;
    gap: var(--space-3);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
</style>
