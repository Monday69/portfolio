---
import type { CollectionEntry } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import { ui } from '../i18n/fr';
import { categories } from '../content.config';

interface Props {
  projects: CollectionEntry<'projects'>[];
}
const { projects } = Astro.props;
const slugOf = (p: CollectionEntry<'projects'>) => p.id.split('/').at(-1)!;
const pad = (value: number) => String(value).padStart(2, '0');
const total = projects.length;
---

<section id="projets" class="section">
  <div class="container">
    <p class="eyebrow">Projets</p>
    <h2 class="section-title">Des systèmes complets, de la donnée à la production</h2>

    <div class="filters" role="group" aria-label="Filtrer les projets">
      <button type="button" data-filter="all" aria-pressed="true">{ui.categories.all}</button>
      {
        categories.map((c) => (
          <button type="button" data-filter={c} aria-pressed="false">
            {ui.categories[c]}
          </button>
        ))
      }
    </div>
  </div>

  <!-- Parcours caméra : la grille 3x2 est déplacée par un seul ScrollTrigger -->
  <div class="camera" data-camera>
    <div class="camera__track" data-camera-track>
      {
        projects.map((project) => (
          <div class="camera__cell" data-camera-cell>
            <ProjectCard project={project} slug={slugOf(project)} large />
          </div>
        ))
      }
    </div>

    <div class="camera__hud" data-camera-hud>
      <span class="camera__counter" data-camera-counter aria-hidden="true">
        {pad(1)} / {pad(total)}
      </span>
      <div class="camera__dots">
        {
          projects.map((project, index) => (
            <button
              type="button"
              class="camera__dot"
              data-camera-dot={index}
              aria-label={`Aller au projet ${pad(index + 1)} — ${project.data.title}`}
              aria-current={index === 0 ? 'true' : 'false'}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  const camera = document.querySelector<HTMLElement>('[data-camera]');
  const track = camera?.querySelector<HTMLElement>('[data-camera-track]');
  const cells = track ? [...track.querySelectorAll<HTMLElement>('[data-camera-cell]')] : [];
  const counter = camera?.querySelector<HTMLElement>('[data-camera-counter]');
  const dots = camera ? [...camera.querySelectorAll<HTMLElement>('[data-camera-dot]')] : [];

  const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');

  const pad = (value: number) => String(value).padStart(2, '0');

  // Branché par le script GSAP quand le rail est actif.
  let afterFilter: () => void = () => {};

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const filter = button.dataset.filter ?? 'all';
      filterButtons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      cells.forEach((cell) => {
        const card = cell.querySelector<HTMLElement>('[data-cats]');
        const cats = card?.dataset.cats?.split(' ') ?? [];
        cell.hidden = filter !== 'all' && !cats.includes(filter);
      });
      afterFilter();
    });
  });

  if (camera && track && cells.length > 1) {
    const root = camera;
    const rail = track;
    const mq = window.matchMedia('(min-width: 861px) and (prefers-reduced-motion: no-preference)');
    const SEGMENTS = cells.length - 1;

    let started = false;
    let teardown: () => void = () => {};

    const setActive = (index: number) => {
      const clamped = Math.min(Math.max(index, 0), SEGMENTS);
      if (counter) counter.textContent = `${pad(clamped + 1)} / ${pad(cells.length)}`;
      dots.forEach((dot, i) => dot.setAttribute('aria-current', String(i === clamped)));
    };

    const start = async () => {
      if (started) return;
      started = true;

      const [{ gsap }, { ScrollTrigger }] = await Promise.all([
        import('gsap'),
        import('gsap/ScrollTrigger'),
      ]);
      gsap.registerPlugin(ScrollTrigger);

      let tl: gsap.core.Timeline | null = null;

      const build = () => {
        // Tout démontage d'abord : le rail n'est actif que sur la vue complète.
        tl?.scrollTrigger?.kill(true);
        tl?.kill();
        tl = null;
        root.classList.remove('is-rail');
        gsap.set(rail, { clearProps: 'transform' });

        const allVisible = cells.every((cell) => !cell.hidden);
        if (!mq.matches || !allVisible) {
          setActive(0);
          ScrollTrigger.refresh();
          return;
        }

        root.classList.add('is-rail');

        // Neutralise l'apparition générique : la carte est pilotée par le rail.
        cells.forEach((cell) => cell.querySelector('.card')?.classList.add('is-visible'));

        tl = gsap.timeline({
          scrollTrigger: {
            trigger: root,
            start: 'top top',
            end: () => `+=${Math.round(window.innerHeight * 4.5)}`,
            pin: true,
            scrub: 0.5,
            anticipatePin: 1,
            invalidateOnRefresh: true,
            onUpdate: (self) => setActive(Math.round(self.progress * SEGMENTS)),
          },
        });

        // Trajet en « S » : → → ↓ ← ←
        tl.to(rail, { xPercent: -100 / 3, ease: 'none', duration: 1 })
          .to(rail, { xPercent: -200 / 3, ease: 'none', duration: 1 })
          .to(rail, { yPercent: -50, ease: 'none', duration: 1 })
          .to(rail, { xPercent: -100 / 3, ease: 'none', duration: 1 })
          .to(rail, { xPercent: 0, ease: 'none', duration: 1 });

        setActive(0);
        ScrollTrigger.refresh();
      };

      dots.forEach((dot, index) => {
        dot.addEventListener('click', () => {
          const trigger = tl?.scrollTrigger;
          if (!trigger) return;
          const target = trigger.start + (trigger.end - trigger.start) * (index / SEGMENTS);
          window.scrollTo({ top: target, behavior: 'smooth' });
        });
      });

      afterFilter = () => build();
      mq.addEventListener('change', build);
      build();

      teardown = () => {
        tl?.scrollTrigger?.kill(true);
        tl?.kill();
        tl = null;
        root.classList.remove('is-rail');
        gsap.set(rail, { clearProps: 'transform' });
        teardown = () => {};
      };

      window.addEventListener('pagehide', () => teardown(), { once: true });
    };

    if (mq.matches) void start();
    mq.addEventListener('change', (event) => {
      if (event.matches) void start();
    });
  }
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: var(--space-3);
  }
  .filters button {
    font: inherit;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--muted);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.375rem 0.875rem;
    cursor: pointer;
  }
  .filters button:hover {
    color: var(--text);
  }
  .filters button[aria-pressed='true'] {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  /* Base : pile verticale (mobile, reduce, sans JS, filtre actif) */
  .camera {
    position: relative;
    width: 100%;
  }
  .camera__track {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    width: min(100% - 2 * var(--gutter), var(--container));
    margin-inline: auto;
    padding-block: var(--space-3);
  }
  .camera__cell {
    display: grid;
    place-items: center;
  }
  .camera__cell[hidden] {
    display: none;
  }
  .camera__hud {
    display: none;
  }

  /* Rail caméra : posé par le script, desktop + motion autorisé */
  .camera.is-rail {
    height: 100svh;
    overflow: hidden;
  }
  .camera.is-rail .camera__track {
    width: 300%;
    height: 200%;
    margin: 0;
    padding: 0;
    gap: 0;
    /* minmax(0, …) : des pistes strictement égales à 1/3 et 1/2, même si une
       carte dépasse la largeur de sa cellule (sinon la piste s'élargit et le
       centrage dérive). */
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(0, 1fr));
    will-change: transform;
  }
  /* Le « S » : 1-2-3 sur la ligne du haut, puis descente sur la 4, retour 5-6 */
  .camera.is-rail .camera__cell:nth-child(1) {
    grid-area: 1 / 1;
  }
  .camera.is-rail .camera__cell:nth-child(2) {
    grid-area: 1 / 2;
  }
  .camera.is-rail .camera__cell:nth-child(3) {
    grid-area: 1 / 3;
  }
  .camera.is-rail .camera__cell:nth-child(4) {
    grid-area: 2 / 3;
  }
  .camera.is-rail .camera__cell:nth-child(5) {
    grid-area: 2 / 2;
  }
  .camera.is-rail .camera__cell:nth-child(6) {
    grid-area: 2 / 1;
  }
  .camera.is-rail .camera__cell {
    /* Place réservée à la navbar (haut) et au HUD (bas) */
    padding: clamp(4.75rem, 8vh, 5.75rem) clamp(1.25rem, 3vw, 2.5rem) clamp(4.25rem, 7.5vh, 5rem);
  }
  .camera.is-rail .camera__cell > :global(.card) {
    /* 100 % = boîte de contenu de la cellule (donc toujours centrable) */
    width: min(100%, 1520px);
    height: clamp(560px, 74svh, 760px);
    max-height: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(360px, 1fr);
  }

  /* Visuel : cadre plein hauteur, capture entière (aucun rognage d'UI) */
  .camera.is-rail .camera__cell > :global(.card .card__media) {
    flex: none;
    aspect-ratio: auto;
    align-self: stretch;
    height: 100%;
    min-height: 0;
    padding: clamp(0.75rem, 1.4vw, 1.5rem);
    background: var(--frame);
    border-bottom: 0;
    border-right: 1px solid var(--border);
  }
  .camera.is-rail .camera__cell > :global(.card .card__media img) {
    object-fit: contain;
    object-position: center;
  }

  /* Colonne texte : échelle éditoriale et ancrage bas */
  .camera.is-rail .camera__cell > :global(.card .card__body) {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: clamp(2rem, 3vw, 3.25rem);
    gap: clamp(0.75rem, 1.2vw, 1.1rem);
  }
  .camera.is-rail .camera__cell > :global(.card h3) {
    font-size: clamp(2rem, 2.8vw, 2.75rem);
    line-height: 1.08;
  }
  .camera.is-rail .camera__cell > :global(.card .tagline) {
    font-size: clamp(1rem, 1.15vw, 1.15rem);
    line-height: 1.6;
    max-width: 40ch;
  }
  .camera.is-rail .camera__cell > :global(.card .metric) {
    padding-top: 0.5rem;
    border-top: 1px solid var(--border);
  }
  .camera.is-rail .camera__cell > :global(.card .metric strong) {
    font-size: clamp(1.15rem, 1.5vw, 1.5rem);
  }
  .camera.is-rail .camera__cell > :global(.card .stack) {
    margin-top: auto;
    padding-top: 1.5rem;
  }

  .camera.is-rail .camera__hud {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    position: absolute;
    left: 50%;
    bottom: clamp(1rem, 3vh, 2rem);
    transform: translateX(-50%);
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: rgb(14 17 22 / 0.72);
    backdrop-filter: blur(8px);
  }
  .camera__counter {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .camera__dots {
    display: grid;
    grid-template-columns: repeat(3, auto);
    gap: 6px;
  }
  /* Les points suivent la trajectoire : 4 en bas à droite, 6 en bas à gauche */
  .camera__dots > :nth-child(4) {
    grid-column: 3;
    grid-row: 2;
  }
  .camera__dots > :nth-child(5) {
    grid-column: 2;
    grid-row: 2;
  }
  .camera__dots > :nth-child(6) {
    grid-column: 1;
    grid-row: 2;
  }
  .camera__dot {
    width: 9px;
    height: 9px;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    transition:
      background-color 0.2s,
      border-color 0.2s;
  }
  .camera__dot:hover {
    border-color: var(--accent);
  }
  .camera__dot[aria-current='true'] {
    background: var(--accent);
    border-color: var(--accent);
  }
</style>
