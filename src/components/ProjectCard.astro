---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import StatusBadge from './StatusBadge.astro';
import Topo from './Topo.astro';
import { ui } from '../i18n/fr';

interface Props {
  project: CollectionEntry<'projects'>;
  slug: string;
  large?: boolean;
}
const { project, slug, large = false } = Astro.props;
const { data } = project;

/**
 * Palier large : la capture occupe ~62 % d'une carte de 1520 px max dans le
 * parcours caméra. On demande jusqu'à 1600 px et on ajoute la largeur native
 * exacte quand elle ne tombe pas sur un palier (aucun upscaling).
 */
const coverWidth = data.cover?.width ?? 0;
const largeWidths = [640, 1100, 1600].filter((width) => width <= coverWidth);
if (coverWidth > 0 && largeWidths.at(-1) !== coverWidth) largeWidths.push(coverWidth);
---

<article
  class:list={['card', 'reveal', { 'card--large': large }]}
  data-cats={data.categories.join(' ')}
  data-project-card
>
  <div class="card__media">
    {
      data.cover ? (
        <Picture
          src={data.cover}
          formats={['avif', 'webp']}
          widths={large ? largeWidths : [480, 800]}
          sizes={
            large ? '(max-width: 860px) 94vw, min(62vw, 940px)' : '(max-width: 860px) 94vw, 360px'
          }
          alt={data.coverAlt ?? ''}
        />
      ) : (
        <div class="placeholder" aria-hidden="true">
          <Topo class="placeholder__topo" seed={data.order} />
          <span>{ui.categories[data.categories[0]!]}</span>
        </div>
      )
    }
  </div>

  <div class="card__body">
    <div class="card__meta" data-part="meta">
      <StatusBadge status={data.status} />
      {data.period && <span class="period">{data.period}</span>}
    </div>
    <h3 data-part="title">
      <a href={`/projets/${slug}/`} class="card__link">{data.title}</a>
    </h3>
    <p class="tagline" data-part="tagline">{data.tagline}</p>
    {
      data.metric && (
        <p class="metric" data-part="metric">
          <strong>{data.metric.value}</strong> {data.metric.label}
        </p>
      )
    }
    <ul class="stack" aria-label={ui.project.stack} data-part="stack">
      {data.stack.slice(0, large ? 6 : 4).map((s) => <li class="tag">{s}</li>)}
    </ul>

    <span class="card__cta">
      Voir le projet <span class="card__arrow" aria-hidden="true">→</span>
    </span>
  </div>
</article>

<script>
  /**
   * Cascade interne d'une carte projet : en-tête, titre, accroche, métrique, stack.
   * La carte est pilotée par `ProjectGrid` via trois évènements :
   *   - `projectcard:prepare`  : masque les blocs avant l'entrée en scène
   *   - `projectcard:activate` : joue la cascade (stagger 0.08)
   *   - `projectcard:reset`    : rend les blocs à leur état statique
   * Rien n'est chargé ni joué sous `prefers-reduced-motion: reduce`.
   */
  const cards = document.querySelectorAll<HTMLElement>('[data-project-card]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (cards.length > 0 && !reduced) {
    const parts = (card: HTMLElement) => [...card.querySelectorAll<HTMLElement>('[data-part]')];

    let loading: Promise<typeof import('gsap').gsap> | null = null;
    const loadGsap = () => (loading ??= import('gsap').then((module) => module.gsap));

    cards.forEach((card) => {
      card.addEventListener('projectcard:prepare', () => {
        const blocks = parts(card);
        if (blocks.length === 0) return;
        void loadGsap().then((gsap) => gsap.set(blocks, { y: 14, opacity: 0 }));
      });

      card.addEventListener('projectcard:activate', () => {
        const blocks = parts(card);
        if (blocks.length === 0) return;
        void loadGsap().then((gsap) =>
          gsap.fromTo(
            blocks,
            { y: 14, opacity: 0 },
            {
              y: 0,
              opacity: 1,
              duration: 0.5,
              ease: 'power2.out',
              stagger: 0.08,
              overwrite: 'auto',
            },
          ),
        );
      });

      card.addEventListener('projectcard:reset', () => {
        const blocks = parts(card);
        if (blocks.length === 0) return;
        void loadGsap().then((gsap) => gsap.set(blocks, { clearProps: 'transform,opacity' }));
      });
    });
  }
</script>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    cursor: pointer;
    transition:
      border-color 0.25s,
      transform 0.25s;
  }
  .card:hover,
  .card:focus-within {
    border-color: var(--accent);
    transform: translateY(-3px);
  }
  .card[hidden] {
    display: none;
  }
  .card__media {
    aspect-ratio: 16 / 10;
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }
  .card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
  .placeholder {
    position: relative;
    height: 100%;
    display: grid;
    place-items: center;
    background: radial-gradient(70% 80% at 70% 30%, rgb(125 211 252 / 0.08), transparent);
  }
  .placeholder :global(.placeholder__topo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--accent);
    opacity: 0.18;
  }
  .placeholder span {
    position: relative;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--muted);
    border: 1px solid var(--border);
    background: var(--bg);
    border-radius: 6px;
    padding: 0.25rem 0.625rem;
  }
  .card__body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: var(--space-3);
    flex: 1;
  }
  .card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  .period {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }
  h3 {
    font-size: var(--step-1);
  }
  .card__link {
    color: var(--text);
    text-decoration: none;
  }
  /* Toute la carte est cliquable (stretched link) */
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
  }
  .card__media :global(img) {
    transition: transform 0.45s ease;
  }
  .card:hover .card__media :global(img),
  .card:focus-within .card__media :global(img) {
    transform: scale(1.02);
  }
  .card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: var(--muted);
    transition: color 0.25s;
  }
  .card__arrow {
    transition: transform 0.25s ease;
  }
  .card:hover .card__cta,
  .card:focus-within .card__cta {
    color: var(--accent);
  }
  .card:hover .card__arrow,
  .card:focus-within .card__arrow {
    transform: translateX(4px);
  }
  .tagline {
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .metric {
    font-size: 0.875rem;
    color: var(--muted);
  }
  .metric strong {
    font-family: var(--font-mono);
    color: var(--accent);
    font-size: 1rem;
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    padding: 0;
    margin: auto 0 0;
  }

  /* Grand format : image à gauche, texte à droite */
  @media (min-width: 861px) {
    .card--large {
      flex-direction: row;
    }
    .card--large .card__media {
      flex: 0 0 52%;
      /* Le ratio des visuels reste verrouillé, même en grand format */
      aspect-ratio: 16 / 10;
      align-self: center;
      min-height: 0;
      border-bottom: 0;
      border-right: 1px solid var(--border);
    }
    .card--large .card__body {
      padding: var(--space-4);
      justify-content: center;
    }
    .card--large h3 {
      font-size: var(--step-2);
    }
    .card--large .stack {
      margin-top: var(--space-1);
    }
  }
</style>
