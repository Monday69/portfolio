---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import { site } from '../data/site';

interface Props {
  background?: ImageMetadata;
}
const { background } = Astro.props;
---

<section id="contact" class="section contact-section">
  {
    background && (
      <Picture
        src={background}
        formats={['avif', 'webp']}
        widths={[960, 1600, 2400]}
        sizes="100vw"
        alt=""
        class="contact__bg"
      />
    )
  }
  <div class="contact__veil" aria-hidden="true"></div>
  {background && <p class="credit">Aoraki / Mont Cook, Nouvelle-Zélande · © Mattéo Bombrun</p>}
  <div class="container contact reveal">
    <p class="eyebrow">Contact</p>
    <h2>Vous recrutez un stagiaire IA pour avril 2027, à Lyon ou Grenoble ?</h2>
    <p class="lead">Écrivez-moi par e-mail ou sur LinkedIn.</p>
    <div class="actions">
      <a class="btn btn--primary" href={`mailto:${site.email}`}><Icon name="mail" /> {site.email}</a>
      <a class="btn" href={site.linkedin}>LinkedIn <Icon name="external" size={16} /></a>
      <a class="btn" href={site.github}>GitHub <Icon name="external" size={16} /></a>
      <a class="btn" href={site.cv} download>CV (PDF) <Icon name="download" size={16} /></a>
    </div>
  </div>
</section>

<style>
  .contact-section {
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(6rem, 5rem + 6vw, 10rem);
  }
  .contact-section :global(.contact__bg) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 30%;
  }
  .contact__veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(55% 60% at 50% 50%, rgb(14 17 22 / 0.75), rgb(14 17 22 / 0.35) 100%),
      linear-gradient(180deg, var(--bg) 0%, transparent 18%);
  }
  .credit {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 1.25rem;
    text-align: right;
    line-height: 1.4;
    text-shadow: 0 1px 6px rgb(14 17 22 / 0.9);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: rgb(230 237 243 / 0.75);
  }
  .contact {
    text-shadow: 0 1px 14px rgb(14 17 22 / 0.8);
  }
  .contact {
    text-align: center;
    display: grid;
    justify-items: center;
    gap: var(--space-2);
  }
  h2 {
    font-size: var(--step-2);
    max-width: 24ch;
  }
  .lead {
    color: var(--text);
    opacity: 0.85;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
</style>
