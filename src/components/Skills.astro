---
import { skills } from '../data/site';
---

<section class="section section--tight" aria-labelledby="competences">
  <div class="container">
    <p class="eyebrow">Compétences</p>
    <h2 id="competences" class="section-title">Ce que j’utilise au quotidien</h2>
    <div class="groups">
      {
        skills.map((g) => (
          <div class="group reveal">
            <h3>{g.family}</h3>
            <ul>
              {g.items.map((s) => (
                <li class="tag">{s}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .section--tight {
    padding-top: 0;
  }
  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: var(--space-3);
  }
  .group {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-3);
    background: var(--surface);
  }
  h3 {
    font-size: 1rem;
    margin-bottom: var(--space-2);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .tag {
    color: var(--text);
  }
</style>
