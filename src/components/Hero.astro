---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import portrait from '../assets/portrait.jpg';
import Topo from './Topo.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';

interface Props {
  /** Photo de montagne en fond (optionnelle tant que les photos ne sont pas fournies) */
  background?: ImageMetadata;
}
const { background } = Astro.props;
---

<section class="hero">
  {
    background && (
      <Picture
        src={background}
        formats={['avif', 'webp']}
        widths={[960, 1600, 2400]}
        sizes="100vw"
        alt=""
        class="hero__bg"
        loading="eager"
      />
    )
  }
  <div class="hero__veil" aria-hidden="true"></div>
  <Topo class="hero__topo" seed={1} />
  {background && <p class="credit">Lever de soleil sur la Muzelle, Oisans · © Mattéo Bombrun</p>}

  <div class="container hero__inner">
    <div class="hero__text">
      <p class="eyebrow">{site.title}</p>
      <h1>{site.name}</h1>
      <p class="pitch">{site.pitch}</p>

      <p class="availability">
        <span class="dot" aria-hidden="true"></span>
        {
          site.availability.map((part, i) => (
            <>
              {i > 0 && (
                <span class="sep" aria-hidden="true">
                  ·
                </span>
              )}
              <span>{part}</span>
            </>
          ))
        }
      </p>

      <div class="cta">
        <a class="btn btn--primary" href="#projets">Voir les projets <Icon name="arrow" /></a>
        <a class="btn" href={site.cv} download>Télécharger le CV <Icon name="download" /></a>
      </div>

      <ul class="links">
        <li><a href={site.github}>GitHub</a></li>
        <li><a href={site.linkedin}>LinkedIn</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      </ul>
    </div>

    <div class="hero__portrait">
      <Picture
        src={portrait}
        formats={['avif', 'webp']}
        widths={[280, 560]}
        sizes="280px"
        alt="Portrait de Mattéo Bombrun"
        loading="eager"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: min(92vh, 860px);
    display: flex;
    align-items: center;
    padding-block: var(--space-5);
  }
  .hero :global(.hero__bg) {
    position: absolute;
    inset: 0;
    z-index: -3;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 35%;
  }
  .hero__veil {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(90deg, rgb(14 17 22 / 0.72) 0%, rgb(14 17 22 / 0.4) 40%, transparent 75%),
      linear-gradient(180deg, transparent 0%, transparent 70%, rgb(14 17 22 / 0.5) 88%, var(--bg));
  }
  .hero :global(.hero__topo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    color: var(--accent);
    opacity: 0.05;
  }
  .credit {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 1.25rem;
    text-align: right;
    line-height: 1.4;
    text-shadow: 0 1px 6px rgb(14 17 22 / 0.9);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: rgb(230 237 243 / 0.7);
  }
  .hero__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-5);
    align-items: center;
  }
  .hero__text {
    text-shadow: 0 1px 14px rgb(14 17 22 / 0.7);
  }
  h1 {
    font-size: var(--step-3);
    margin-top: var(--space-2);
  }
  .pitch {
    font-size: var(--step-1);
    color: var(--text);
    opacity: 0.9;
    max-width: 34ch;
    margin-top: var(--space-3);
  }
  .availability {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: rgb(22 27 34 / 0.7);
  }
  .sep {
    color: var(--muted);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--glow);
    box-shadow: 0 0 0 4px rgb(245 158 107 / 0.18);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
    margin: var(--space-3) 0 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
  .links a {
    color: var(--muted);
    text-decoration: none;
  }
  .links a:hover {
    color: var(--accent);
  }
  .hero__portrait :global(img) {
    width: 280px;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: 50% 30%;
    border-radius: 50%;
    border: 2px solid var(--accent);
    box-shadow: 0 0 0 10px rgb(125 211 252 / 0.06);
  }
  @media (max-width: 860px) {
    .hero {
      min-height: auto;
    }
    .hero__veil {
      background: linear-gradient(
        180deg,
        rgb(14 17 22 / 0.15),
        rgb(14 17 22 / 0.6) 45%,
        rgb(14 17 22 / 0.8) 75%,
        var(--bg)
      );
    }
    .credit {
      position: absolute;
      left: var(--gutter);
      right: var(--gutter);
      bottom: 1.25rem;
      text-align: right;
      line-height: 1.4;
      text-shadow: 0 1px 6px rgb(14 17 22 / 0.9);
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: rgb(230 237 243 / 0.7);
    }
    .hero__inner {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
    .hero__portrait {
      order: -1;
    }
    .hero__portrait :global(img) {
      width: 128px;
    }
  }

  /*
   * Écran vertical (y compris un 1080p avec zoom 125 / 150 %, dont la largeur
   * CSS descend sous 769px) : la section reprend un rapport proche de la photo
   * paysage, ce qui évite le recadrage massif. `min-height: min-content`
   * empêche tout rognage quand le contenu dépasse la cible (téléphone portrait).
   */
  @media (orientation: portrait) {
    .hero {
      min-height: min-content;
      height: clamp(400px, 58vw, 640px);
    }
    .hero :global(.hero__bg) {
      object-position: center 25%;
    }
    .credit {
      bottom: 0.75rem;
    }
  }
</style>
